{
  "manifest_version": 3,
  "name": "My YouTube",
  "version": "1.0.6",
  "description": "Some YouTube goodies",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": ["https://youtube.com/*", "https://www.youtube.com/*"],
  "action": {
    "default_title": "My YouTube settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["src/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "css": ["src/content.css"],
      "js": ["src/core.js", "src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
